.agents
.aws-sam/
.worktrees/

# GitHub Actions config secrets
.github/config*.json
requirements.txt
.vscode
.env
dev_docs
wrangler.toml

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.DS_Store
node_modules/
.codex

# Generated by scripts/build-docs.sh (predev / deploy-web)
web/public/docs-content/

# Migration SQL files (one-off, run manually via psql)
# Local-only directory shared across worktrees via symlink (see worktree/post-create.sh)
# Pattern with no trailing slash matches both the real dir (main repo) and symlink (worktrees)
/migration

# Local/generated repository artifacts (not tracked; kept on disk)
/assets/screenshots/
/control/
/scripts/migration-*.md

# One-off backfill scripts (run manually, not part of app)
backfill_*.py

# Tests are kept local-only.
# Patterns with no trailing slash match both the real dir (main repo) and
# symlink (worktrees; see worktree/post-create.sh). A trailing slash would
# match directories only and leave mode-120000 test symlinks untracked, so
# `y dev commit` stage-all could commit them and later replace the real
# suites in the main checkout with dead self-links.
agent/tests
api/tests
cli/tests
storage/tests
worker/tests
web/e2e
web/src/**/*.test.ts
web/src/**/*.test.tsx
.pytest_cache/
web/test-results/
web/playwright-report/
